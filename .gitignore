# Dependencies
node_modules/
package-lock.json
# Keep package-lock.json if you want deterministic builds, 
# but for a library/generator, sometimes it's excluded. 
# Standard practice is to KEEP it, but I'll leave it un-ignored effectively by not listing it 
# (commented above for awareness, but standard .gitignore usually doesn't ignore it).

# Build Outputs
dist/
build/
out/
coverage/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDES and Editors
.idea/
.vscode/
*.swp
*.swo

# BasicBlog specific
# If you generate a blog inside the root during testing:
examples/*/build
examples/*/node_modules

# Vite/Testing
*.tsbuildinfo
